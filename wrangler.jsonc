{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cybat-edge-collector",
  "main": "src/index.js",
  "compatibility_date": "2024-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "vars": {
    "CYBAT_INGESTION_URL": "https://gcp-ingest.cybat.co",
    "CYBAT_MAX_BODY_BYTES": "65536",
    "CYBAT_PROJECT_ID": "cloudflare"
  },
  "observability": {
    "enabled": true
  }
}
